th 0.254) (type default)) (fill (type none)) (uuid "7f9e19ea-78ce-5bc7-964c-908ff9ca9d6e")) (text "06  LIMITS / MECHANICAL" (at 388.5 183.39999999999998 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "612a1505-1148-5e04-90e6-1e62673380e8")) (text "U1 pin numbering follows manufacturer P1.\nUSB and regulator remain on module.\nF1 protects ONLY the shared sensor branch.\nNo independent supply may drive a port when OFF." (at 17.5 136.5 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "98c492bd-7875-5474-87b2-21c9dc65f655")) (text "U2: inputs at reset. INT unused: poll.\nR9-R24 pull up; buttons close to GND." (at 210.0 93.1 0) (effects (font (size 1.1 1.1)) (justify left)) (uuid "bba6eebc-9852-5c5e-a24c-e7b5cfbbdfa6")) (text "JP1 OPEN = disabled (factory/default assembly).\nShort only after configuring all PWM channels OFF.\nKeep MODE2 OUTNE=00; no autonomous watchdog.\nPWM2/3 spare; unused PWM outputs explicitly NC." (at 395.5 155.39999999999998 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "698a1fde-f33f-544b-9c7b-d4f9ab95a68b")) (text "3.3V logic only. I2C 100kHz initial target.\nGP10 is future MODE; current GP14 is not on P1." (at 17.5 259.0 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "2ab47939-67ce-5d60-a1e1-7c83e6622688")) (text "EN default LOW; ordinary logic, NOT STO.\nIRQ is 3.3V open-drain only. No motor-power pins.\nExternal servo driver/protocol remains unselected." (at 210.0 259.0 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "c008b9d7-4735-52b6-b47a-5515b7e8b4ae")) (text "ENGINEERING SAMPLE - NOT POWERED/VALIDATED\nNo servo motor driver or safety circuit on this PCB.\nADC input: 0..5V only; all sensors powered by board.\nESD TVS is NOT a guarantee against DC overvoltage.\nDo not hot-plug or inject signals while unpowered.\nCurrent firmware does not implement these expansions.\nSee circuit-notes.md for USB budget and limits." (at 395.5 196.0 0) (effects (font (size 1.35 1.35)) (justify left)) (uuid "a173ddec-f23f-5af8-8792-ff864a37b9b0")) (polyline (pts (xy 10.5 280.0) (xy 147.0 280.0) (xy 147.0 374.5) (xy 10.5 374.5) (xy 10.5 280.0)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "a72e87c2-669c-55d7-9931-1d3491623a81")) (text "07  ANALOG THROTTLE GP26" (at 14.0 285.59999999999997 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "3d3d7212-bb76-5fcd-b95a-c984bfe7be66")) (text "1=5V_SENSOR  2=GND  3=OUT\nFixed 1:2 divider; fc ~318Hz; no bypass.\nTVS at connector; capacitor near ADC." (at 14.0 364.0 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "879ad168-92d8-5af7-9e9d-480ae76e4dce")) (polyline (pts (xy 154.0 280.0) (xy 290.5 280.0) (xy 290.5 374.5) (xy 154.0 374.5) (xy 154.0 280.0)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "af31aaac-32e0-59ff-bb55-2e513a98f66b")) (text "08  ANALOG BRAKE GP27" (at 157.5 285.59999999999997 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "d0227780-eb0e-5d03-b067-a709e1ae537c")) (text "1=5V_SENSOR  2=GND  3=OUT\nFixed 1:2 divider; fc ~318Hz; no bypass.\nTVS at connector; capacitor near ADC." (at 157.5 364.0 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "879ad168-92d8-5af7-9e9d-480ae76e4dce")) (polyline (pts (xy 297.5 280.0) (xy 434.0 280.0) (xy 434.0 374.5) (xy 297.5 374.5) (xy 297.5 280.0)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "2eff10f8-8232-5de4-9596-ffc0aa1e45e8")) (text "09  ANALOG CLUTCH GP28" (at 301.0 285.59999999999997 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "4002b10d-7658-5e82-b111-84c8786b2f6f")) (text "1=5V_SENSOR  2=GND  3=OUT\nFixed 1:2 divider; fc ~318Hz; no bypass.\nTVS at connector; capacitor near ADC." (at 301.0 364.0 0) (effects (font (size 1.15 1.15)) (justify left)) (uuid "879ad168-92d8-5af7-9e9d-480ae76e4dce")) (polyline (pts (xy 441.0 280.0) (xy 577.5 280.0) (xy 577.5 374.5) (xy 441.0 374.5) (xy 441.0 280.0)) (stroke (width 0.254) (type default)) (fill (type none)) (uuid "58e60f94-078b-51d8-b3b4-01f524c